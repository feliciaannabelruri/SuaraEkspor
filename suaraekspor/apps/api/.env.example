# Database — Supabase Postgres (Project Settings -> Database -> Connection string -> URI)
# Pakai connection pooler (port 6543, ?pgbouncer=true) kalau deploy ke serverless; untuk lokal port 5432 langsung juga bisa.
DATABASE_URL=postgresql://postgres:password@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# JWT — minimal 32 karakter acak
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter

# Groq — dipakai untuk Whisper (STT), Llama 4 Scout (vision), Llama 3.3 (listing/pricing/chat), Orpheus (TTS)
GROQ_API_KEY=gsk_...

# ImageKit — storage foto & audio produk (imagekit.io -> Developer Options)
IMAGEKIT_PUBLIC_KEY=public_...
IMAGEKIT_PRIVATE_KEY=private_...
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# Opsional — kirim OTP asli via WhatsApp (Fonnte). Kalau kosong, sistem pakai dev-mode (OTP selalu 123456)
# Token ini JUGA dipakai sebagai nomor WhatsApp AI middleman platform (bukan per-penjual) — lihat WHATSAPP_PLATFORM_NUMBER di bawah.
FONNTE_API_KEY=

# Opsional — URL publik API ini (dipakai untuk menyusun webhook URL WhatsApp di fitur Integrasi WhatsApp)
API_PUBLIC_URL=http://localhost:4000

# Nomor WhatsApp platform SuaraEkspor — SATU nomor untuk semua penjual (format internasional tanpa '+', mis. 6289501116888)
WHATSAPP_PLATFORM_NUMBER=

# Kunci rahasia webhook WhatsApp — bebas isi string acak, dipakai di URL webhook yang di-set di dashboard Fonnte (?secret=...)
WHATSAPP_WEBHOOK_SECRET=

# Opsional — folder sementara untuk file audio TTS sebelum diupload ke ImageKit
AUDIO_OUTPUT_DIR=/tmp/suaraekspor-audio

NODE_ENV=development
PORT=4000
