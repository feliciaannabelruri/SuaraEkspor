generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String        @id @default(cuid())
  phone         String        @unique
  role          UserRole      @default(seller)
  name          String?
  province      String?
  localLanguage String?       @default("id")
  businessName  String?
  address       String?
  isVerified    Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  products      Product[]
  conversations Conversation[] @relation("SellerConversations")
  buyerConvs    Conversation[] @relation("BuyerConversations")
  otpTokens     OtpToken[]
  sellerTxns    Transaction[]  @relation("SellerTransactions")
  buyerTxns     Transaction[]  @relation("BuyerTransactions")
  notifications Notification[]
  // Middleman relations
  managedSellers MiddlemanRelation[] @relation("AsMiddleman")
  managedBy      MiddlemanRelation[] @relation("AsSeller")
  whatsappThreads WhatsappThread[]
  whatsappMessages WhatsappMessage[]
}

enum UserRole {
  seller
  buyer
  admin
}

model OtpToken {
  id        String   @id @default(cuid())
  userId    String
  token     String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
}

model Product {
  id                   String         @id @default(cuid())
  sellerId             String
  status               ProductStatus  @default(processing)
  originalAudioUrl     String?
  originalTranscript   String?
  detectedLanguage     String?
  photoUrls            String[]
  visionAnalysis       Json?
  recommendedPriceUsd  Float?
  priceRangeMin        Float?
  priceRangeMax        Float?
  targetMarkets        String[]
  category             String?
  exportReadinessScore Int?
  dataCompletenessScore Int?
  aiPipelineStage      String?        @default("pending")
  pipelineError        String?
  viewCount            Int            @default(0)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  seller               User           @relation(fields: [sellerId], references: [id])
  listings             ProductListing[]
  conversations        Conversation[]
  transactions         Transaction[]
  whatsappThreads      WhatsappThread[]
  whatsappMessages     WhatsappMessage[]
}

enum ProductStatus {
  processing
  active
  inactive
}

model Transaction {
  id             String            @id @default(cuid())
  productId      String
  sellerId       String
  buyerId        String
  quantity       Int               @default(1)
  totalUsd       Float
  status         TransactionStatus @default(order_placed)
  isSimulated    Boolean           @default(true)
  notes          String?           @db.Text
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  product        Product           @relation(fields: [productId], references: [id])
  seller         User              @relation("SellerTransactions", fields: [sellerId], references: [id])
  buyer          User              @relation("BuyerTransactions", fields: [buyerId], references: [id])
  legalDocuments LegalDocument[]
}

// ─── Legal Export Documents ──────────────────────────────────────────────
// Invoice / packing list / certificate of origin per transaction. `data` and
// `exportContext` are JSON rather than dedicated columns because the three
// doc types have different field sets and this is a UMKM-friendly best-effort
// generator, not a rigid customs system — the per-type Zod schema in
// packages/ai-engine/src/legal-docs is the real source of truth for shape.
model LegalDocument {
  id            String         @id @default(cuid())
  transactionId String
  type          LegalDocType
  status        LegalDocStatus @default(draft)
  data          Json
  exportContext Json?
  pdfUrl        String?
  aiNotes       String?        @db.Text
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  transaction   Transaction    @relation(fields: [transactionId], references: [id])

  @@unique([transactionId, type])
}

enum LegalDocType {
  commercial_invoice
  packing_list
  certificate_of_origin
}

enum LegalDocStatus {
  draft
  finalized
}

enum TransactionStatus {
  order_placed
  payment_simulated
  escrow_held
  released
  completed
  cancelled
}

model ProductListing {
  id           String  @id @default(cuid())
  productId    String
  languageCode String
  languageName String
  title        String
  description  String  @db.Text
  keywords     String[]

  product      Product @relation(fields: [productId], references: [id])

  @@unique([productId, languageCode])
}

model Conversation {
  id          String    @id @default(cuid())
  productId   String
  sellerId    String
  buyerId     String?
  buyerName   String?
  buyerLang   String    @default("en")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  product     Product   @relation(fields: [productId], references: [id])
  seller      User      @relation("SellerConversations", fields: [sellerId], references: [id])
  buyer       User?     @relation("BuyerConversations", fields: [buyerId], references: [id])
  messages    Message[]
}

model Message {
  id              String       @id @default(cuid())
  conversationId  String
  senderRole      String
  originalText    String       @db.Text
  originalLang    String
  translatedText  String?      @db.Text
  aiGenerated     Boolean      @default(false)
  summaryForSeller String?     @db.Text
  summaryAudioUrl  String?
  createdAt       DateTime     @default(now())

  conversation    Conversation @relation(fields: [conversationId], references: [id])
}

// ─── Middleman Feature ────────────────────────────────────────────────────────

model MiddlemanRelation {
  id          String           @id @default(cuid())
  middlemanId String
  sellerId    String
  status      MiddlemanStatus  @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  middleman   User             @relation("AsMiddleman", fields: [middlemanId], references: [id])
  seller      User             @relation("AsSeller", fields: [sellerId], references: [id])

  @@unique([middlemanId, sellerId])
}

enum MiddlemanStatus {
  PENDING
  APPROVED
  REJECTED
}

// ─── WhatsApp Integration (via Fonnte) ─────────────────────────────────────
// Satu nomor WhatsApp AI milik platform SuaraEkspor (bukan per-penjual) —
// penjual tidak perlu setup/connect apa pun. Routing ke penjual yang tepat
// dilakukan lewat WhatsappThread, dipetakan dari kode referensi produk yang
// disertakan saat buyer klik "Chat via WhatsApp" di halaman produk.

model WhatsappThread {
  id         String   @id @default(cuid())
  buyerPhone String   @unique
  buyerName  String?
  sellerId   String
  productId  String?
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  seller     User     @relation(fields: [sellerId], references: [id])
  product    Product? @relation(fields: [productId], references: [id])
}

model WhatsappMessage {
  id              String                @id @default(cuid())
  sellerId        String
  productId       String?
  buyerPhone      String
  buyerName       String?
  originalText    String                @db.Text
  originalLang    String?
  translatedText  String?               @db.Text
  aiReply         String?               @db.Text
  sellerReplyText String?               @db.Text
  sellerReplyLang String?
  status          WhatsappMessageStatus @default(pending)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  seller          User                  @relation(fields: [sellerId], references: [id])
  product         Product?              @relation(fields: [productId], references: [id])

  @@index([sellerId, status])
}

enum WhatsappMessageStatus {
  pending
  approved
  rejected
}

// ─── Notifications ────────────────────────────────────────────────────────

model Notification {
  id             String   @id @default(cuid())
  userId         String
  type           String
  title          String
  message        String   @db.Text
  conversationId String?
  audioUrl       String?
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())

  user           User     @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
}